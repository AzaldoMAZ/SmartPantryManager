<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expiry alerts"
            android:textSize="16sp"
            android:textColor="@color/text_dark" />

        <Switch
            android:id="@+id/switchExpiryAlerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Preferred unit"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <Spinner
        android:id="@+id/spinnerPreferredUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonClearPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/error_red"
        android:text="Clear pantry data" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="About Smart Pantry Manager"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/pantry_green" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Smart Pantry Manager helps you reduce food waste by suggesting recipes you can make using strictly the ingredients you already have. Data is stored locally on this device using SQLite."
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
